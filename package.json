{
  "name": "shadcn-theme-provider",
  "version": "0.3.1",
  "description": "Dual-axis theme provider for shadcn/ui — mode (light/dark/system) + palette (runtime CSS switching)",
  "author": "brokeboiflex",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./script": {
      "import": {
        "types": "./dist/script.d.ts",
        "default": "./dist/script.js"
      },
      "require": {
        "types": "./dist/script.d.cts",
        "default": "./dist/script.cjs"
      }
    },
    "./tailwind.css": "./css/tailwind.css"
  },
  "typesVersions": {
    "*": {
      "script": [
        "./dist/script.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "css",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:build": "node scripts/verify-build.mjs",
    "prepublishOnly": "npm run typecheck && npm test && npm run build && npm run verify:build"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "shadcn",
    "shadcn-ui",
    "theme",
    "theme-provider",
    "dark-mode",
    "palette",
    "tailwindcss",
    "react"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/brokeboiflex/shadcn-theme-provider"
  },
  "homepage": "https://github.com/brokeboiflex/shadcn-theme-provider#readme"
}
